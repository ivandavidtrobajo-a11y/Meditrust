# Multimodal capture analysis providers
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
HF_API_TOKEN=
HF_DEFAULT_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# Optional JSON catalog for the models visible to clinicians.
# If configured, include every provider/model pair that should be selectable.
CAPTURE_MODELS_JSON=

# Clinical rules must be supplied and approved by the clinical team.
# Empty rules intentionally keep readable captures in "needs_review" state.
SMARTWATCH_CLINICAL_RULES_JSON={}

# Persistent MongoDB queue worker
CAPTURE_ANALYSIS_MAX_ATTEMPTS=5
CAPTURE_ANALYSIS_POLL_SECONDS=3
CAPTURE_ANALYSIS_LEASE_MINUTES=10
